rules_version = '2';
// Scout reads and writes Firestore only from its own server, using a service account (which bypasses these rules).
// Nothing is ever meant to be reached straight from a browser, so every direct client request is refused.
// Deploy:  firebase deploy --only firestore:rules      (or paste into Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
