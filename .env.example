# Copy this file to .env and fill in your keys:   cp .env.example .env
# Keys are read on the server only and are never sent to the browser.
# A key in .env takes priority over a variable of the same name set in your system environment.

# ── Required ───────────────────────────────────────────────────────────────
# TinyFish API key (Search, Fetch and Agent). See https://docs.tinyfish.ai/authentication
TINYFISH_API_KEY=

# ── For Vercel / serverless: store data in Google Firestore ────────────────────────
# A Google Cloud service-account key (role: Cloud Datastore User), as one line of JSON or as base64.
# Leave empty to use the local SQLite file instead. Setup guide: README → "Google Cloud setup".
# In a .env file wrap raw JSON in single quotes:  GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GOOGLE_SERVICE_ACCOUNT_JSON=

# FIRESTORE_PROJECT_ID=            # defaults to the project inside the key
# STORE=sqlite                     # or "firestore": override the automatic choice

# Enables the scheduled-alerts endpoint /api/cron/tick (call it with "Authorization: Bearer <this value>",
# e.g. from Google Cloud Scheduler). Use a long random string. Without it the endpoint stays disabled.
CRON_SECRET= 

# ── Optional ───────────────────────────────────────────────────────────────
# AI reading of postings with Gemini 3.5 Flash-Lite: cleaner pay, visa, skills and summaries.
# Get a key at https://aistudio.google.com/apikey (the account needs billing credits).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Push alert notifications to Telegram as well as the in-app bell.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Dev server port (default 3000) and SQLite file location (default data/scout.db).
PORT=3000
# SCOUT_DB=data/scout.db
